<view class="mirror-page">
  <view class="ambient ambient--one"></view>
  <view class="ambient ambient--two"></view>
  <view class="nav" style="padding-top: {{layout.statusBarHeight}}px; height: {{layout.navContentHeight}}px;">
    <view class="brand">
      <text class="brand__eyebrow">CATOPTRIC STUDIO</text>
      <text class="brand__name">猫猫魔镜</text>
    </view>
    <view class="nav__sigil" bindtap="onOpenAtlas" hover-class="tap-dim">✦</view>
  </view>

  <view class="mirror-shell">
    <view class="mirror-crown"><view class="mirror-crown__line"></view><text>✦</text><view class="mirror-crown__line"></view></view>
    <view class="mirror-frame">
      <view class="mirror-frame__inner">
        <view class="mirror-glint"></view>
        <view class="mirror-orbit mirror-orbit--one"></view>
        <view class="mirror-orbit mirror-orbit--two"></view>
        <view wx:if="{{introVisible && ready}}" class="spell" bindtap="onDismissIntro">
          <text class="spell__mark">✦</text>
          <text class="spell__title">你可以问魔镜</text>
          <text class="spell__line">今天穿什么 · 去海边怎么搭</text>
          <text class="spell__line">看看趣味镜卡 · 整理最近的状态</text>
          <text class="spell__hint">轻触镜面开始</text>
        </view>
        <scroll-view class="dialogue" scroll-y scroll-into-view="{{scrollAnchor}}" enhanced show-scrollbar="{{false}}">
          <view class="dialogue__spacer"></view>
          <view wx:for="{{messages}}" wx:key="id" id="message-{{item.id}}" class="message message--{{item.role}}">
            <text wx:if="{{item.role === 'mirror'}}" class="message__speaker">魔镜</text>
            <text class="message__content">{{item.content}}</text>
          </view>
          <view wx:if="{{sending}}" class="message message--mirror">
            <text class="message__speaker">魔镜</text>
            <view class="thinking"><view></view><view></view><view></view></view>
          </view>
          <view wx:if="{{errorText}}" class="mirror-error" bindtap="startMirror">
            <text>{{errorText}}</text><text class="mirror-error__retry">重新点亮</text>
          </view>
          <view class="dialogue__bottom"></view>
        </scroll-view>
        <image class="mirror-familiar" src="/assets/cats/wellbeing-sun-orange.webp" mode="aspectFit" />
      </view>
    </view>
  </view>

  <scroll-view wx:if="{{ready && messages.length <= 1}}" class="suggestions" scroll-x show-scrollbar="{{false}}">
    <view class="suggestions__track">
      <view wx:for="{{suggestions}}" wx:key="*this" class="suggestion" data-text="{{item}}" bindtap="onSuggestion" hover-class="tap-dim">{{item}}</view>
    </view>
  </scroll-view>
  <view class="quick-tools">
    <view class="quick-tool" bindtap="onOpenTryon" hover-class="tap-dim"><text class="quick-tool__icon">◇</text><text>试衣</text></view>
    <view class="quick-tool" bindtap="onOpenWellbeing" hover-class="tap-dim"><text class="quick-tool__icon">☾</text><text>状态</text></view>
    <view class="quick-tool" bindtap="onOpenAtlas" hover-class="tap-dim"><text class="quick-tool__icon">✦</text><text>图鉴</text></view>
  </view>
  <view class="composer">
    <input class="composer__input" value="{{inputValue}}" placeholder="问问魔镜……" placeholder-class="composer__placeholder" confirm-type="send" bindinput="onInput" bindconfirm="onSend" maxlength="1000" />
    <view class="composer__send {{sending || !inputValue ? 'is-disabled' : ''}}" bindtap="onSend" hover-class="tap-dim">↑</view>
  </view>
</view>
