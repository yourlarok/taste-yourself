page { min-height: 100%; background: #0f0e16; color: #f8f2e7; }.atlas-page { min-height: 100vh; padding: 0 28rpx 150rpx; box-sizing: border-box; background: radial-gradient(circle at 20% 5%,rgba(91,70,111,.32),transparent 28%),#0f0e16; }.atlas-nav { display: flex; align-items: center; justify-content: space-between; box-sizing: content-box; }.atlas-nav__eyebrow { display:block;color:#9b90a8;font-size:17rpx;letter-spacing:4rpx; }.atlas-nav__title { display:block;margin-top:4rpx;font-family:serif;font-size:38rpx;letter-spacing:5rpx; }.atlas-nav__count { width:56rpx;height:56rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid rgba(232,201,136,.34);border-radius:50%;color:#e8c988; }.atlas-state { padding:180rpx 30rpx;text-align:center;color:#8e8797; }.atlas-empty { margin-top:100rpx;display:flex;flex-direction:column;align-items:center;text-align:center; }.atlas-empty__mirror { width:260rpx;height:340rpx;display:flex;align-items:center;justify-content:center;border:4rpx double #a88955;border-radius:150rpx 150rpx 50rpx 50rpx;color:#e8c988;font-size:44rpx;background:linear-gradient(160deg,#322b42,#171520);box-shadow:inset 0 0 50rpx rgba(175,143,195,.22); }.atlas-empty__title { margin-top:38rpx;font-family:serif;font-size:38rpx; }.atlas-empty__desc { max-width:560rpx;margin-top:18rpx;color:#928b99;font-size:25rpx;line-height:1.7; }.atlas-empty__action { margin-top:32rpx;padding:20rpx 48rpx;border-radius:999rpx;color:#211927;background:#dec17f; }.atlas-grid { display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin-top:34rpx; }.card { position:relative;min-height:510rpx;overflow:hidden;padding:20rpx;box-sizing:border-box;border:1rpx solid rgba(232,201,136,.22);border-radius:32rpx;text-align:center;background:linear-gradient(170deg,#3a3348,#181620 66%); }.card--sun{background:linear-gradient(170deg,#5a422d,#1b171b 66%)}.card--mist{background:linear-gradient(170deg,#3d4960,#171923 66%)}.card--moss{background:linear-gradient(170deg,#3e4938,#171a18 66%)}.card--moon{background:linear-gradient(170deg,#3a3651,#16151f 66%)}.card--night{background:linear-gradient(170deg,#193253,#0d1018 66%)}.card__family { display:block;text-align:left;color:#d6bb7e;font-size:17rpx;letter-spacing:3rpx; }.card__cat { width:290rpx;height:290rpx;margin-top:-4rpx; }.card__name { display:block;color:#fff7e9;font-family:serif;font-size:31rpx; }.card__title { display:block;margin-top:10rpx;color:#aaa2b1;font-size:21rpx;line-height:1.4; }.card__date { display:block;margin-top:13rpx;color:#686370;font-size:16rpx; }
