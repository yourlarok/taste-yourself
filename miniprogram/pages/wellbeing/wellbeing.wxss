page { min-height: 100%; background: #11101a; color: #f8f2e7; }
.wellbeing-page { min-height: 100vh; padding: 0 34rpx 80rpx; box-sizing: border-box; background: radial-gradient(circle at 85% 8%, rgba(111,87,139,.35), transparent 30%), linear-gradient(180deg,#171522,#0f0e16); }
.nav { display: flex; align-items: center; justify-content: space-between; box-sizing: content-box; }
.nav__back,.nav__space { width: 64rpx; }.nav__back { font-size: 54rpx; color: #e4c986; }.nav__title { font-family: serif; font-size: 30rpx; letter-spacing: 5rpx; }
.eyebrow { color: #b79dd0; font-size: 19rpx; letter-spacing: 5rpx; }
.intro,.question,.context { padding-top: 55rpx; }
.intro__title,.question__title,.context__title { display: block; margin-top: 24rpx; font-family: serif; color: #fff8eb; font-size: 50rpx; line-height: 1.28; }
.intro__desc,.context__desc { display: block; margin-top: 22rpx; color: #aaa3b2; font-size: 27rpx; line-height: 1.72; }
.intro__cat-wrap { height: 520rpx; margin-top: 20rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(232,201,136,.14); border-radius: 280rpx 280rpx 60rpx 60rpx; background: radial-gradient(circle,#393a52 0,rgba(30,28,43,.25) 55%,transparent 70%); }
.intro__cat { width: 500rpx; height: 500rpx; }.intro__note { display: block; margin-top: 20rpx; text-align: center; color: #716c7a; font-size: 21rpx; }
.primary { min-height: 94rpx; margin-top: 28rpx; display: flex; align-items: center; justify-content: center; border-radius: 999rpx; color: #201827; font-size: 28rpx; font-weight: 600; letter-spacing: 2rpx; background: linear-gradient(135deg,#f1d99c,#caa96b); box-shadow: 0 18rpx 42rpx rgba(0,0,0,.25); }.primary.is-disabled { opacity: .5; }
.progress { height: 4rpx; overflow: hidden; margin-bottom: 38rpx; border-radius: 99rpx; background: rgba(255,255,255,.08); }.progress__fill { height: 100%; background: linear-gradient(90deg,#a986c7,#e8c988); transition: width .25s ease; }
.question__title { min-height: 190rpx; font-size: 43rpx; }.options { margin-top: 30rpx; display: flex; flex-direction: column; gap: 14rpx; }
.option { min-height: 82rpx; padding: 0 25rpx; display: flex; align-items: center; justify-content: space-between; border: 1rpx solid rgba(232,201,136,.14); border-radius: 20rpx; color: #ddd5e2; font-size: 26rpx; background: rgba(255,255,255,.035); }.option--pressed { border-color: #d3b676; background: rgba(232,201,136,.12); }.option__value { color: #857b90; }
.chips { margin-top: 34rpx; display: flex; flex-wrap: wrap; gap: 16rpx; }.chip { padding: 18rpx 25rpx; border: 1rpx solid rgba(255,255,255,.1); border-radius: 999rpx; color: #aaa2b2; font-size: 24rpx; background: rgba(255,255,255,.03); }.chip.is-selected { color: #211925; border-color: #d9bd7c; background: #d9bd7c; }
.safety { margin-top: 45rpx; padding: 28rpx; border: 1rpx solid rgba(232,201,136,.16); border-radius: 26rpx; background: rgba(255,255,255,.035); }.safety__title { display: block; color: #f2e2bd; font-size: 27rpx; }.safety__desc { display: block; margin-top: 13rpx; color: #aba3b2; font-size: 24rpx; line-height: 1.65; }.safety__choices { display: flex; gap: 15rpx; margin-top: 23rpx; }.safety__choice { flex: 1; height: 72rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(255,255,255,.12); border-radius: 16rpx; color: #bbb3c1; }.safety__choice.is-selected { color: #17131c; border-color: #dcc486; background: #dcc486; }.safety__choice--urgent.is-selected { color: #fff; border-color: #94575d; background: #94575d; }.error { display: block; margin-top: 18rpx; text-align: center; color: #e6aaa5; }
.result { position: fixed; inset: 0; padding: 170rpx 34rpx 0; box-sizing: border-box; }.result-card { position: relative; overflow: hidden; min-height: 830rpx; padding: 480rpx 42rpx 42rpx; box-sizing: border-box; border: 1rpx solid rgba(232,201,136,.35); border-radius: 52rpx; text-align: center; background: linear-gradient(170deg,#373148,#17141f 62%); box-shadow: 0 30rpx 80rpx rgba(0,0,0,.4); }.result-card--sun { background: linear-gradient(170deg,#5b452e,#211a1d 62%); }.result-card--mist { background: linear-gradient(170deg,#3f4b63,#181a25 62%); }.result-card--moss { background: linear-gradient(170deg,#3f4838,#181b19 62%); }.result-card--moon { background: linear-gradient(170deg,#393550,#171620 62%); }.result-card--night { background: linear-gradient(170deg,#172d4d,#0d1019 62%); }
.result-card__halo { position: absolute; top: 80rpx; left: 50%; width: 490rpx; height: 490rpx; transform: translateX(-50%); border-radius: 50%; background: radial-gradient(circle,rgba(232,201,136,.22),transparent 68%); }.result-card__cat { position: absolute; top: 25rpx; left: 50%; width: 550rpx; height: 550rpx; transform: translateX(-50%); }.result-card__eyebrow { position: relative; color: #d5ba7d; font-size: 19rpx; letter-spacing: 4rpx; }.result-card__title { position: relative; display: block; margin-top: 15rpx; font-family: serif; color: #fff8ec; font-size: 42rpx; }.result-card__body { position: relative; display: block; margin-top: 17rpx; color: #b9b0bf; font-size: 24rpx; line-height: 1.65; }.score { position: relative; margin-top: 26rpx; }.score__value { color: #f1d58e; font-family: serif; font-size: 70rpx; }.score__unit { margin-left: 8rpx; color: #8c8393; font-size: 22rpx; }.score__label { position: relative; display: block; color: #d6ccda; font-size: 23rpx; }
.result-section { margin-top: 24rpx; padding: 30rpx; border: 1rpx solid rgba(255,255,255,.07); border-radius: 28rpx; background: rgba(255,255,255,.03); }.result-section__title { display: block; margin-bottom: 16rpx; color: #f1ddb0; font-size: 27rpx; }.result-line { display: block; margin-top: 10rpx; color: #aaa3b2; font-size: 24rpx; line-height: 1.6; }.step-line { display: flex; gap: 16rpx; margin-top: 16rpx; color: #c6becb; font-size: 24rpx; line-height: 1.55; }.step-line__num { flex: 0 0 38rpx; height: 38rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #211927; background: #d7bb7a; }.notice { display: block; margin: 26rpx 12rpx 0; color: #777180; font-size: 21rpx; line-height: 1.6; text-align: center; }.result__safe { height: 90rpx; }
.panel-in { animation: panelIn .5s ease both; } @keyframes panelIn { from { opacity: 0; transform: translateY(16rpx); } to { opacity: 1; transform: none; } }
