.mirror-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #8f867a;
}

.camera-surface,
.live-player-surface,
.ambient-surface,
.result-surface,
.surface-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.live-pusher-source {
  position: absolute;
  z-index: 1;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  pointer-events: none;
}

.live-player-surface {
  z-index: 2;
}

.result-surface {
  z-index: 2;
}

.ai-result-notice {
  position: absolute;
  z-index: 6;
  left: 28rpx;
  right: 28rpx;
  bottom: 290rpx;
  padding: 12rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(22, 19, 16, .55);
  color: #fffaf2;
  font-size: 20rpx;
  line-height: 1.45;
  text-align: center;
}

.ambient-surface {
  background:
    radial-gradient(circle at 50% 18%, rgba(255, 255, 255, .82), transparent 28%),
    linear-gradient(155deg, #c9c1b6, #898075);
}

.portrait-silhouette {
  position: absolute;
  top: 20%;
  left: 50%;
  width: 230rpx;
  height: 720rpx;
  transform: translateX(-50%);
  border-radius: 115rpx 115rpx 70rpx 70rpx;
  background: linear-gradient(to bottom, #c9aa95 0 17%, #eee5da 17% 58%, #554f4a 58%);
  box-shadow: 0 50rpx 100rpx rgba(0, 0, 0, .16);
  opacity: .86;
}

.surface-shade {
  pointer-events: none;
  background: linear-gradient(to bottom, rgba(24, 21, 18, .12), transparent 30%, rgba(18, 16, 14, .42));
}

.safe-top {
  padding-top: calc(env(safe-area-inset-top) + 22rpx);
}

.safe-bottom {
  padding-bottom: calc(env(safe-area-inset-bottom) + 20rpx);
}

.safe-bottom-sheet {
  padding-bottom: calc(env(safe-area-inset-bottom) + 32rpx);
}

.topbar,
.studio-top {
  position: relative;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 36rpx;
  padding-right: 36rpx;
}

.brand {
  color: #211e1a;
  font-size: 36rpx;
  font-weight: 550;
  letter-spacing: 1rpx;
}

.quiet-button,
.glass-button {
  margin: 0;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(250, 247, 242, .54);
  color: #29241f;
  font-size: 24rpx;
  line-height: 1.6;
  backdrop-filter: blur(18rpx);
}

.intro-copy {
  position: absolute;
  z-index: 3;
  top: 190rpx;
  left: 42rpx;
  right: 42rpx;
}

.intro-title,
.intro-subtitle,
.recent-title,
.recent-meta,
.scan-title,
.scan-copy,
.analysis-notice {
  display: block;
}

.intro-title {
  margin-bottom: 10rpx;
  font-size: 52rpx;
  font-weight: 520;
}

.intro-subtitle {
  width: 520rpx;
  color: #514a43;
  font-size: 28rpx;
  line-height: 1.55;
}

.home-dock,
.studio-dock {
  position: absolute;
  z-index: 5;
  left: 24rpx;
  right: 24rpx;
  bottom: 20rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, .76);
  border-radius: 48rpx;
  background: rgba(249, 246, 240, .88);
  box-shadow: 0 30rpx 72rpx rgba(30, 25, 20, .22);
  backdrop-filter: blur(32rpx);
}

.recent-row {
  display: flex;
  align-items: center;
  width: 100%;
  margin: 0 0 18rpx;
  padding: 0;
  background: transparent;
  text-align: left;
  line-height: normal;
}

.recent-thumb {
  width: 86rpx;
  height: 100rpx;
  flex: 0 0 auto;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #778796, #273746);
}

.recent-thumb image {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
}

.recent-copy {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.recent-title {
  font-size: 29rpx;
  font-weight: 520;
}

.recent-meta {
  margin-top: 8rpx;
  color: #71675e;
  font-size: 23rpx;
}

.chevron {
  color: #71675e;
  font-size: 46rpx;
}

.primary-button,
.secondary-button {
  width: 100%;
  margin: 0;
  border-radius: 30rpx;
  font-size: 29rpx;
  line-height: 92rpx;
}

.danger-button {
  width: 100%;
  margin: 14rpx 0 0;
  border-radius: 30rpx;
  background: #f3e4e0;
  color: #8a3328;
  font-size: 29rpx;
  line-height: 92rpx;
}

.primary-button {
  background: #2c2823;
  color: #faf6ef;
}

.secondary-button {
  margin-top: 14rpx;
  background: #eee8df;
  color: #342f29;
}

.studio-top {
  color: #fffaf2;
}

.studio-top .glass-button {
  background: rgba(22, 19, 16, .48);
  color: #fffaf2;
}

.compact {
  min-width: 94rpx;
}

.mode-pill,
.countdown {
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(22, 19, 16, .48);
  color: #fffaf2;
  font-size: 23rpx;
  backdrop-filter: blur(18rpx);
}

.countdown,
.camera-message {
  position: absolute;
  z-index: 6;
  top: 154rpx;
  left: 50%;
  transform: translateX(-50%);
}

.capture-button {
  position: absolute;
  z-index: 6;
  left: 50%;
  bottom: 315rpx;
  width: 154rpx;
  height: 154rpx;
  margin: 0;
  padding: 0;
  transform: translateX(-50%);
  border: 9rpx solid rgba(255, 250, 242, .82);
  border-radius: 50%;
  background: rgba(31, 27, 23, .58);
  color: #fffaf2;
  font-size: 24rpx;
  line-height: 136rpx;
  backdrop-filter: blur(18rpx);
}

.scan-guide {
  position: absolute;
  z-index: 7;
  inset: 150rpx 36rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #fffaf2;
}

.body-outline {
  width: 330rpx;
  height: 820rpx;
  border: 4rpx solid rgba(255, 250, 242, .78);
  border-radius: 170rpx 170rpx 100rpx 100rpx;
  box-shadow: 0 0 0 999rpx rgba(16, 14, 12, .18);
}

.scan-progress {
  position: absolute;
  top: 18rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(20, 18, 16, .5);
  font-size: 22rpx;
}

.scan-instruction {
  position: absolute;
  bottom: 125rpx;
  font-size: 31rpx;
  font-weight: 520;
}

.scan-countdown {
  position: absolute;
  top: 45%;
  font-size: 110rpx;
  font-variant-numeric: tabular-nums;
}

.scan-cancel {
  position: absolute;
  bottom: 45rpx;
  margin: 0;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(20, 18, 16, .52);
  color: #fffaf2;
  font-size: 24rpx;
  line-height: 1.7;
}

.camera-message {
  width: 450rpx;
  color: #fffaf2;
  text-align: center;
}

.studio-dock {
  border-color: rgba(255, 255, 255, .11);
  background: rgba(25, 22, 19, .84);
}

.garment-rail {
  width: 100%;
  white-space: nowrap;
}

.garment-chip {
  display: inline-flex;
  width: 88rpx;
  height: 102rpx;
  margin: 5rpx 15rpx 20rpx 5rpx;
  padding: 0;
  border-radius: 25rpx;
  vertical-align: middle;
}

.garment-chip.is-active {
  box-shadow: 0 0 0 5rpx #fffaf2;
}

.garment-sand { background: linear-gradient(145deg, #dfd0bd, #76685b); }
.garment-blue { background: linear-gradient(145deg, #718394, #273745); }
.garment-brown { background: linear-gradient(145deg, #9c7564, #4b3028); }

.garment-add {
  align-items: center;
  justify-content: center;
  border: 1rpx dashed rgba(255, 255, 255, .5);
  background: transparent;
  color: #fffaf2;
  font-size: 40rpx;
}

.garment-custom {
  overflow: hidden;
  background: #6d655d;
}

.garment-image {
  width: 100%;
  height: 100%;
  border-radius: 25rpx;
}

.tool-row {
  display: grid;
  grid-template-columns: 1fr 260rpx;
  gap: 14rpx;
}

.analysis-button,
.live-button {
  margin: 0;
  border-radius: 30rpx;
  font-size: 27rpx;
  line-height: 88rpx;
}

.analysis-button {
  background: rgba(255, 255, 255, .12);
  color: #fffaf2;
  text-align: left;
  padding-left: 28rpx;
}

.live-button {
  background: #fffaf2;
  color: #211e1a;
}

.live-button[disabled] {
  background: #d7cfc4;
  color: #4f4840;
}

.sheet-mask {
  position: absolute;
  z-index: 8;
  inset: 0;
  background: rgba(18, 15, 12, .2);
}

.bottom-sheet {
  position: absolute;
  z-index: 9;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 36rpx 36rpx;
  border-radius: 52rpx 52rpx 0 0;
  background: #fbf8f3;
  box-shadow: 0 -30rpx 90rpx rgba(0, 0, 0, .24);
}

.sheet-handle {
  width: 82rpx;
  height: 8rpx;
  margin: 0 auto 26rpx;
  border-radius: 999rpx;
  background: #d1c8bd;
}

.sheet-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
  font-size: 31rpx;
  font-weight: 520;
}

.sheet-close {
  margin: 0;
  padding: 8rpx;
  background: transparent;
  color: #746a61;
  font-size: 23rpx;
  line-height: normal;
}

.size-row {
  display: grid;
  grid-template-columns: 70rpx 1fr;
  gap: 18rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid #e0d8cf;
}

.size-label {
  font-size: 29rpx;
  font-weight: 550;
}

.size-copy {
  font-size: 27rpx;
}

.size-note {
  display: block;
  margin-top: 7rpx;
  color: #746a61;
  font-size: 23rpx;
}

.analysis-notice {
  padding-top: 12rpx;
  color: #857a70;
  font-size: 21rpx;
}

.scan-title {
  margin-bottom: 14rpx;
  font-size: 34rpx;
  font-weight: 550;
}

.scan-copy {
  margin-bottom: 28rpx;
  color: #655c54;
  font-size: 26rpx;
  line-height: 1.6;
}

.usage-summary {
  display: block;
  margin: -8rpx 0 24rpx;
  color: #857a70;
  font-size: 23rpx;
}

.privacy-button {
  width: 100%;
  margin: 0 0 14rpx;
  padding: 0;
  background: transparent;
  color: #665c53;
  font-size: 25rpx;
  line-height: 56rpx;
  text-align: left;
  text-decoration: underline;
}
