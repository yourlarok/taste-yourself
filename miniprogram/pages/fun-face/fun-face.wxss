page{height:100%;background:#0e0d15;color:#f8f2e8}.face-page{height:100vh;padding:0 34rpx;box-sizing:border-box;background:radial-gradient(circle at 50% 22%,#332a46 0,transparent 42%),#0e0d15}.nav{display:flex;align-items:center;justify-content:space-between;box-sizing:content-box;font-family:serif;font-size:29rpx;letter-spacing:4rpx}.nav__back,.nav__space{width:64rpx}.nav__back{color:#e5c882;font-size:54rpx}.eyebrow{color:#b69ccb;font-size:18rpx;letter-spacing:5rpx}.title{display:block;margin-top:20rpx;font-family:serif;font-size:52rpx;line-height:1.25}.desc{display:block;margin-top:22rpx;color:#a9a1b1;font-size:25rpx;line-height:1.72}.intro{padding-top:42rpx}.sigil{height:460rpx;margin-top:12rpx;display:flex;align-items:center;justify-content:center;border-radius:260rpx 260rpx 54rpx 54rpx;background:radial-gradient(circle,rgba(216,187,122,.18),transparent 65%)}.sigil image{width:460rpx;height:460rpx}.primary{height:92rpx;margin-top:28rpx;display:flex;align-items:center;justify-content:center;border-radius:999rpx;color:#201827;font-size:28rpx;font-weight:600;background:linear-gradient(135deg,#f0d795,#c7a563)}.privacy,.notice,.explanation{display:block;margin:18rpx 10rpx 0;color:#746e7b;font-size:20rpx;line-height:1.6;text-align:center}.used{padding-top:80rpx;text-align:center}.used image{width:480rpx;height:480rpx}.used .desc{max-width:560rpx;margin:20rpx auto 0}.question{padding-top:55rpx}.progress{height:4rpx;margin-bottom:45rpx;overflow:hidden;border-radius:20rpx;background:rgba(255,255,255,.08)}.progress view{height:100%;background:linear-gradient(90deg,#a581c3,#e5ca86)}.question__title{display:block;min-height:180rpx;margin-top:25rpx;font-family:serif;font-size:47rpx;line-height:1.35}.scale-labels{display:flex;justify-content:space-between;margin-top:60rpx;color:#a9a1b1;font-size:22rpx}.scale{position:relative;display:flex;justify-content:space-between;margin-top:35rpx}.scale::before{content:'';position:absolute;left:38rpx;right:38rpx;top:38rpx;height:2rpx;background:linear-gradient(90deg,#777085,#e2c680)}.scale__point{position:relative;z-index:2;width:76rpx;height:76rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid rgba(232,201,136,.35);border-radius:50%;color:#c7bdcd;background:#1c1926}.scale__point--pressed{color:#201827;background:#e0c47e;transform:scale(.92)}.scale__hint{display:block;margin-top:30rpx;text-align:center;color:#6f6976;font-size:21rpx}.camera-stage{position:fixed;inset:0;background:#08080d}.camera{position:absolute;inset:0;width:100%;height:100%}.camera--empty{display:flex;align-items:center;justify-content:center;color:#aaa;background:#181722}.guide-oval{position:absolute;left:50%;top:19%;width:470rpx;height:590rpx;transform:translateX(-50%);border:2rpx solid rgba(237,211,155,.72);border-radius:50%;box-shadow:0 0 0 999rpx rgba(5,5,9,.26),0 0 30rpx rgba(232,201,136,.25)}.camera-copy{position:absolute;top:10%;left:0;right:0;display:flex;flex-direction:column;align-items:center;color:#fff}.camera-copy text:last-child{margin-top:8rpx;color:rgba(255,255,255,.65);font-size:22rpx}.shutter{position:absolute;left:50%;bottom:90rpx;width:110rpx;height:110rpx;padding:8rpx;transform:translateX(-50%);border:2rpx solid #f2dfb6;border-radius:50%;box-sizing:border-box}.shutter view{width:100%;height:100%;border-radius:50%;background:#f4ead7}.shutter.is-disabled{opacity:.45}.error{position:absolute;left:40rpx;right:40rpx;bottom:225rpx;padding:18rpx;border-radius:16rpx;text-align:center;color:#ffd4ce;background:rgba(92,42,48,.8)}.processing{height:78vh;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#ece0c4}.rune{font-size:70rpx;color:#e4c77e;animation:pulse 1.5s infinite}.processing__sub{margin-top:14rpx;color:#777080;font-size:21rpx}.result{position:fixed;inset:0;padding:145rpx 34rpx 0;box-sizing:border-box}.card{position:relative;min-height:760rpx;overflow:hidden;padding:450rpx 35rpx 35rpx;box-sizing:border-box;border:1rpx solid rgba(232,201,136,.35);border-radius:52rpx;text-align:center;background:linear-gradient(170deg,#493b57,#17141f 65%)}.card--sun{background:linear-gradient(170deg,#5b452e,#211a1d 65%)}.card--mist{background:linear-gradient(170deg,#3f4b63,#181a25 65%)}.card--moss{background:linear-gradient(170deg,#3f4838,#181b19 65%)}.card--moon{background:linear-gradient(170deg,#393550,#171620 65%)}.card--night{background:linear-gradient(170deg,#172d4d,#0d1019 65%)}.card__cat{position:absolute;top:5rpx;left:50%;width:530rpx;height:530rpx;transform:translateX(-50%)}.card__eyebrow{color:#d5ba7d;font-size:18rpx;letter-spacing:3rpx}.card__title{display:block;margin-top:14rpx;font-family:serif;font-size:38rpx}.card__score{display:block;margin-top:12rpx;color:#f0d28b;font-family:serif;font-size:68rpx}.card__body{display:block;color:#aaa2b1;font-size:22rpx;line-height:1.55}.dimensions,.observations{margin-top:22rpx;padding:28rpx;border:1rpx solid rgba(255,255,255,.07);border-radius:28rpx;background:rgba(255,255,255,.03)}.dimension{margin-top:18rpx}.dimension:first-child{margin-top:0}.dimension__head{display:flex;justify-content:space-between;color:#c7bfcb;font-size:23rpx}.dimension__track{height:6rpx;margin-top:11rpx;border-radius:10rpx;background:rgba(255,255,255,.08)}.dimension__track view{height:100%;border-radius:10rpx;background:linear-gradient(90deg,#9a79b8,#e1c57e)}.section-title{display:block;margin-bottom:12rpx;color:#e7d4a8;font-size:26rpx}.observations>text:not(.section-title){display:block;margin-top:8rpx;color:#aaa2b1;font-size:23rpx}.safe{height:90rpx}.fade-in{animation:fadeIn .5s ease both}@keyframes fadeIn{from{opacity:0;transform:translateY(14rpx)}to{opacity:1;transform:none}}@keyframes pulse{50%{opacity:.45;transform:scale(.9)}}
