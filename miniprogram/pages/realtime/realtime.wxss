page { height: 100%; background: #211b14; }
.live-page { position: relative; width: 100%; height: 100vh; overflow: hidden; background: #211b14; }
web-view { width: 100%; height: 100%; }
.live-loading { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #fdfbf7; background: radial-gradient(ellipse at 50% 42%, #45392b 0%, #211b14 65%); }
.live-mark { width: 62rpx; height: 62rpx; margin-bottom: 34rpx; border: 2rpx solid rgba(253,251,247,.28); border-top-color: #e7cda9; border-radius: 50%; animation: live-spin 1.2s linear infinite; }
.live-title { font-size: 32rpx; letter-spacing: 2rpx; }
.live-copy { margin-top: 16rpx; color: rgba(253,251,247,.6); font-size: 24rpx; }
.live-error { max-width: 600rpx; margin: 32rpx 48rpx 0; color: #f0bcae; text-align: center; line-height: 1.6; font-size: 24rpx; }
.live-back { margin-top: 32rpx; padding: 20rpx 36rpx; border: 1px solid rgba(253,251,247,.55); border-radius: 999rpx; font-size: 24rpx; }
@keyframes live-spin { to { transform: rotate(360deg); } }
