.studio {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #211B14;
}

/* ---- 画布 ---- */
.canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.canvas__img {
  width: 100%;
  height: 100%;
}

.rt-player {
  z-index: 2;
}

/* 推流画面作为播放流建立前的取景底层，生成后的播放流覆盖在上方。 */
.rt-pusher {
  z-index: 1;
}

.canvas--placeholder {
  background: linear-gradient(180deg, #332C23 0%, #211B14 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.frame {
  position: relative;
  width: 480rpx;
  height: 640rpx;
}

.frame__corner {
  position: absolute;
  width: 56rpx;
  height: 56rpx;
  border-color: rgba(255, 255, 255, 0.5);
  border-style: solid;
}

.frame__corner--tl { left: 0; top: 0; border-width: 2rpx 0 0 2rpx; }
.frame__corner--tr { right: 0; top: 0; border-width: 2rpx 2rpx 0 0; }
.frame__corner--bl { left: 0; bottom: 0; border-width: 0 0 2rpx 2rpx; }
.frame__corner--br { right: 0; bottom: 0; border-width: 0 2rpx 2rpx 0; }

.canvas__tip {
  margin-top: var(--s5);
  padding: 0 var(--s8);
  color: rgba(255, 255, 255, 0.6);
  font-size: var(--f-xs);
  letter-spacing: 2rpx;
  text-align: center;
  line-height: 1.7;
}

.canvas__auth {
  margin-top: var(--s4);
  min-height: 88rpx;
  padding: 0 var(--s5);
  border-radius: var(--r-full);
  background: rgba(253, 251, 247, 0.94);
  color: var(--ink-1);
  font-size: var(--f-xs);
  font-weight: 600;
  letter-spacing: 3rpx;
  display: flex;
  align-items: center;
}

/* ---- 顶部：磨砂圆形控件 + 状态胶囊 ---- */
.top {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  z-index: 30;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding-left: var(--s3);
}

.top__btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--frost);
  border: 1rpx solid var(--frost-light);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
}

.top__btn .i {
  font-size: 36rpx;
}

.top__btn--save {
  position: absolute;
  transform: translateY(-50%);
}

.top__status {
  flex: 1;
  display: flex;
  flex-direction: row;
  justify-content: center;
  padding-right: 72rpx; /* 与左侧返回按钮对称，状态视觉居中 */
}

.top__status-text {
  max-width: 420rpx;
  padding: 12rpx var(--s3);
  border-radius: var(--r-full);
  background: var(--frost);
  border: 1rpx solid var(--frost-light);
  color: rgba(255, 255, 255, 0.92);
  font-size: 20rpx;
  letter-spacing: 3rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---- 生成进度线 ---- */
.progress {
  position: absolute;
  left: 15%;
  right: 15%;
  height: 2rpx;
  border-radius: 2rpx;
  background: rgba(255, 255, 255, 0.18);
  overflow: hidden;
  z-index: 32;
}

.progress__bar {
  width: 38%;
  height: 100%;
  border-radius: 2rpx;
  background: var(--accent-soft);
  animation: progress-slide 1.2s var(--ease) infinite;
}

@keyframes progress-slide {
  0% { transform: translateX(-110%); }
  100% { transform: translateX(300%); }
}

/* ---- 生成中遮罩 ---- */
.genmask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(28, 23, 18, 0.42);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 20;
}

.genmask__box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--s5) var(--s6);
  border-radius: var(--r-l);
  background: rgba(33, 27, 20, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.genmask .spinner {
  width: 48rpx;
  height: 48rpx;
}

.genmask__text {
  margin-top: var(--s3);
  color: #FFFFFF;
  font-size: var(--f-s);
  letter-spacing: 4rpx;
}

/* ---- 横幅 ---- */
.banner {
  position: absolute;
  left: var(--s3);
  right: var(--s3);
  z-index: 40;
}

/* ---- 动态倒计时 ---- */
.rt {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  z-index: 35;
  display: flex;
  flex-direction: row;
  align-items: baseline;
  background: var(--frost);
  border: 1rpx solid var(--frost-light);
  border-radius: var(--r-full);
  padding: 10rpx var(--s4);
}

.rt__num {
  font-family: var(--serif);
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 600;
}

.rt__unit {
  margin-left: 8rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

/* ---- 结果签名版 ---- */
.plate {
  position: absolute;
  left: var(--s4);
  z-index: 15;
  display: flex;
  flex-direction: column;
  padding-left: var(--s3);
  border-left: 2rpx solid rgba(233, 217, 196, 0.85);
}

.plate__eyebrow {
  font-size: 18rpx;
  letter-spacing: 4rpx;
  color: rgba(255, 255, 255, 0.62);
}

.plate__title {
  margin-top: 6rpx;
  font-family: var(--serif);
  font-size: var(--f-l);
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #FFFFFF;
  text-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.4);
}

.plate__meta {
  margin-top: 4rpx;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* ---- 底部操作层 ---- */
.bottom {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 25;
  padding-top: var(--s8);
  background: linear-gradient(180deg, rgba(28, 23, 18, 0) 0%, rgba(28, 23, 18, 0.66) 42%);
  display: flex;
  flex-direction: column;
}

.bottom garment-strip {
  margin-bottom: var(--s3);
}
