.studio {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #211D18;
}

/* ---- 画布 ---- */
.canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.canvas__img {
  width: 100%;
  height: 100%;
}

.canvas--placeholder {
  background: linear-gradient(180deg, #322C24 0%, #211D18 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.frame {
  position: relative;
  width: 480rpx;
  height: 640rpx;
}

.frame__corner {
  position: absolute;
  width: 56rpx;
  height: 56rpx;
  border-color: rgba(255, 255, 255, 0.55);
  border-style: solid;
}

.frame__corner--tl { left: 0; top: 0; border-width: 4rpx 0 0 4rpx; border-radius: 12rpx 0 0 0; }
.frame__corner--tr { right: 0; top: 0; border-width: 4rpx 4rpx 0 0; border-radius: 0 12rpx 0 0; }
.frame__corner--bl { left: 0; bottom: 0; border-width: 0 0 4rpx 4rpx; border-radius: 0 0 0 12rpx; }
.frame__corner--br { right: 0; bottom: 0; border-width: 0 4rpx 4rpx 0; border-radius: 0 0 12rpx 0; }

.canvas__tip {
  margin-top: var(--s5);
  padding: 0 var(--s8);
  color: rgba(255, 255, 255, 0.65);
  font-size: var(--f-s);
  text-align: center;
  line-height: 1.6;
}

.canvas__auth {
  margin-top: var(--s4);
  min-height: 88rpx;
  padding: 0 var(--s5);
  border-radius: var(--r-full);
  background: rgba(255, 255, 255, 0.92);
  color: var(--ink-1);
  font-size: var(--f-s);
  font-weight: 600;
  display: flex;
  align-items: center;
}

/* ---- 生成中遮罩 ---- */
.genmask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(32, 27, 22, 0.55);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 20;
}

.genmask .spinner {
  width: 56rpx;
  height: 56rpx;
}

.genmask__text {
  margin-top: var(--s3);
  color: #FFFFFF;
  font-size: var(--f-m);
  letter-spacing: 2rpx;
}

/* ---- 顶部 ---- */
.top {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  z-index: 30;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.top__back {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 56rpx;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.35);
}

.top__status {
  flex: 1;
  color: rgba(255, 255, 255, 0.92);
  font-size: var(--f-s);
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.35);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.top__save {
  position: absolute;
  transform: translateY(-50%);
  min-width: 88rpx;
  height: 56rpx;
  padding: 0 var(--s2);
  border-radius: var(--r-full);
  background: rgba(255, 255, 255, 0.9);
  color: var(--ink-1);
  font-size: var(--f-s);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---- 横幅 ---- */
.banner {
  position: absolute;
  left: var(--s3);
  right: var(--s3);
  z-index: 40;
}

/* ---- 动态倒计时 ---- */
.rt {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  z-index: 35;
  display: flex;
  flex-direction: row;
  align-items: baseline;
  background: rgba(32, 27, 22, 0.6);
  border-radius: var(--r-full);
  padding: var(--s1) var(--s4);
}

.rt__num {
  color: #FFFFFF;
  font-size: var(--f-xl);
  font-weight: 600;
}

.rt__unit {
  margin-left: 6rpx;
  color: rgba(255, 255, 255, 0.75);
  font-size: var(--f-xs);
}

/* ---- AI 提示 ---- */
.ai-chip {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  z-index: 15;
  padding: 8rpx var(--s3);
  border-radius: var(--r-full);
  background: rgba(32, 27, 22, 0.55);
  color: rgba(255, 255, 255, 0.88);
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

/* ---- 底部操作层 ---- */
.bottom {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 25;
  padding-top: var(--s6);
  background: linear-gradient(180deg, rgba(32, 27, 22, 0) 0%, rgba(32, 27, 22, 0.62) 38%);
  display: flex;
  flex-direction: column;
}

.bottom garment-strip {
  margin-bottom: var(--s3);
}
