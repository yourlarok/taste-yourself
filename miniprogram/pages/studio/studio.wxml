<view class="studio {{reduceMotion ? 'reduce-motion' : ''}}" wx:if="{{layout}}">

  <!-- 画布层：相机 / 结果图 / 取景占位 -->
  <camera
    wx:if="{{showCamera && !realtimeHasStream}}"
    class="canvas"
    device-position="front"
    flash="off"
    resolution="medium"
    binderror="onCameraError"
    bindinitdone="onCameraInit"
  ></camera>

  <!-- 真实动态链路：推送相机流，并以服务端换装流覆盖主画布。 -->
  <live-pusher
    wx:if="{{realtimeHasStream}}"
    class="canvas rt-pusher"
    url="{{realtimePublishUrl}}"
    mode="RTC"
    autopush
    enable-camera
    enable-mic="{{false}}"
    beauty="0"
    whiteness="0"
    binderror="onRealtimeMediaError"
  ></live-pusher>
  <live-player
    wx:if="{{realtimeHasStream}}"
    class="canvas rt-player"
    src="{{realtimePlayUrl}}"
    mode="RTC"
    autoplay
    muted
    object-fit="fillCrop"
    binderror="onRealtimeMediaError"
  ></live-player>

  <view wx:if="{{phase === 'result'}}" class="canvas" bindtap="onTapResult">
    <image class="canvas__img" src="{{resultImage}}" mode="aspectFill"></image>
  </view>

  <view wx:if="{{!showCamera && phase !== 'result'}}" class="canvas canvas--placeholder">
    <view class="frame">
      <view class="frame__corner frame__corner--tl"></view>
      <view class="frame__corner frame__corner--tr"></view>
      <view class="frame__corner frame__corner--bl"></view>
      <view class="frame__corner frame__corner--br"></view>
    </view>
    <text class="canvas__tip">{{cameraTip}}</text>
    <view wx:if="{{cameraAuth === 'denied'}}" class="canvas__auth" bindtap="onOpenSetting" hover-class="btn-press">开启相机权限</view>
  </view>

  <!-- 顶部：返回 / 状态胶囊 / 保存（均避让胶囊与安全区） -->
  <view class="top" style="padding-top: {{layout.statusBarHeight}}px; height: {{layout.navBarHeight}}px;">
    <view class="top__btn" bindtap="onBack" hover-class="tap-dim"><text class="i i-back"></text></view>
    <view class="top__status"><text class="top__status-text">{{statusLine}}</text></view>
    <view
      wx:if="{{phase === 'result' && realtimeState === 'idle'}}"
      class="top__btn top__btn--save"
      style="right: {{layout.capsuleRightGap}}px; top: {{layout.statusBarHeight + layout.navContentHeight / 2}}px;"
      bindtap="onSave"
      hover-class="tap-dim"
    ><text class="i i-save"></text></view>
  </view>

  <!-- 生成进度线：可感知、不遮挡 -->
  <view wx:if="{{phase === 'capturing' || phase === 'generating'}}" class="progress" style="top: {{layout.navBarHeight + 4}}px;">
    <view class="progress__bar"></view>
  </view>

  <!-- 生成中遮罩：阻断重复提交 -->
  <view wx:if="{{phase === 'capturing' || phase === 'generating'}}" class="genmask">
    <task-progress
      steps="{{tryonProgressSteps}}"
      current="{{tryonProgressIndex}}"
      detail="{{tryonProgressText}}"
    />
  </view>

  <!-- 降级 / 错误横幅：不长期占据大面积 -->
  <view wx:if="{{banner.show}}" class="banner" style="top: {{layout.navBarHeight + 12}}px;">
    <state-feedback
      kind="banner"
      tone="warn"
      title="{{banner.title}}"
      desc="{{banner.desc}}"
      action-text="{{banner.actionText}}"
      closable
      bindaction="onBannerAction"
      bindclose="onBannerClose"
    />
  </view>

  <!-- 动态试衣倒计时：始终可见 -->
  <view wx:if="{{realtimeState === 'active'}}" class="rt" style="top: {{layout.navBarHeight + 28}}px;">
    <text class="rt__num">{{countdown}}</text>
    <text class="rt__unit">秒</text>
  </view>

  <!-- 结果签名版：编辑式说明牌，含 AI 生成提示 -->
  <view wx:if="{{phase === 'result' && realtimeState === 'idle'}}" class="plate" style="bottom: {{layout.safeBottom + 312}}px;">
    <text class="plate__eyebrow">试穿照 · {{resultKindText}}</text>
    <text class="plate__title">{{selectedGarmentName}}</text>
    <text class="plate__meta">{{resultTimeText}} · 点击画面返回相机</text>
  </view>

  <!-- 底部操作层 -->
  <view class="bottom" style="padding-bottom: {{layout.safeBottom + 12}}px;">
    <garment-strip
      catalog="{{catalog}}"
      wardrobe="{{wardrobe}}"
      selected-id="{{selectedGarmentId}}"
      uploading="{{uploading}}"
      upload-percent="{{uploadPercent}}"
      upload-error="{{uploadError}}"
      bindselect="onSelectGarment"
      bindadd="onAddGarment"
      bindretry-upload="onRetryUpload"
    />
    <tryon-controls
      phase="{{phase}}"
      garment-name="{{selectedGarmentName}}"
      generate-disabled="{{generateDisabled}}"
      disabled-hint="{{quotaHint}}"
      generating-text="{{generatingText}}"
      realtime-state="{{realtimeState}}"
      bindgenerate="onGenerate"
      bindopen-fit="onOpenFit"
      bindstart-realtime="onStartRealtime"
      bindend-realtime="onEndRealtime"
    />
  </view>

  <!-- 尺码差异抽屉 -->
  <fit-sheet
    visible="{{fitVisible}}"
    state="{{fitState}}"
    rows="{{fitRows}}"
    source-text="{{fitSourceText}}"
    error-title="{{fitErrorTitle}}"
    error-desc="{{fitErrorDesc}}"
    garment-name="{{selectedGarmentName}}"
    bindclose="onFitClose"
    bindstart-scan="onStartScan"
    bindskip="onFitSkip"
    bindretry="onFitRetry"
  />

  <!-- 尺寸画像采集 -->
  <scan-guide
    id="scanGuide"
    visible="{{scanVisible}}"
    state="{{scanState}}"
    retake-side="{{scanRetakeSide}}"
    fail-title="{{scanFailTitle}}"
    fail-desc="{{scanFailDesc}}"
    processing-step="{{processingStep}}"
    bindagree="onScanAgree"
    bindcancel="onScanCancel"
    bindcaptured="onScanCaptured"
    bindretake="onScanRetake"
    bindretry="onScanRetry"
    bindfinish="onScanFinish"
    bindbackground="onScanBackground"
  />
</view>
