.stage {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: var(--r-l);
  overflow: hidden;
  background: var(--surface-warm);
  transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease);
}

.stage-press {
  transform: scale(0.985);
  opacity: 0.92;
}

/* ---- recent ---- */
.stage__bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.stage__veil {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 55%;
  background: linear-gradient(180deg, rgba(32, 27, 22, 0) 0%, rgba(32, 27, 22, 0.55) 100%);
}

.stage__recent {
  position: absolute;
  left: var(--s4);
  right: var(--s4);
  bottom: var(--s4);
  display: flex;
  flex-direction: column;
}

.stage__gname {
  color: #FFFFFF;
  font-size: var(--f-l);
  font-weight: 600;
  letter-spacing: 1rpx;
}

.stage__time {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: var(--f-s);
}

.stage__actions {
  margin-top: var(--s3);
  display: flex;
  flex-direction: row;
  align-items: center;
}

.stage__pill {
  min-height: 80rpx;
  padding: 0 var(--s4);
  border-radius: var(--r-full);
  background: rgba(255, 255, 255, 0.92);
  color: var(--ink-1);
  font-size: var(--f-m);
  font-weight: 600;
  display: flex;
  align-items: center;
}

.stage__ghost {
  margin-left: var(--s3);
  min-height: 80rpx;
  display: flex;
  align-items: center;
  color: rgba(255, 255, 255, 0.88);
  font-size: var(--f-s);
  text-decoration: underline;
  text-underline-offset: 8rpx;
}

/* ---- empty ---- */
.stage__mirror {
  position: absolute;
  left: var(--s3);
  right: var(--s3);
  top: var(--s3);
  bottom: var(--s3);
  border: 2rpx solid var(--line-strong);
  border-radius: 220rpx 220rpx var(--r-l) var(--r-l);
  background: linear-gradient(165deg, #F7F2E9 0%, #EFE7D9 58%, #EAE0CF 100%);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: var(--s6) var(--s5) var(--s5);
}

.stage__steps {
  display: flex;
  flex-direction: column;
  align-self: flex-start;
}

.stage__step {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 56rpx;
}

.stage__no {
  color: var(--accent);
  font-size: var(--f-m);
  margin-right: var(--s2);
}

.stage__step-text {
  color: var(--ink-1);
  font-size: var(--f-m);
}

.stage__step-line {
  width: 2rpx;
  height: 28rpx;
  margin-left: 14rpx;
  background: var(--line-strong);
}

.stage__demo {
  position: absolute;
  right: var(--s4);
  top: 34%;
  width: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stage__demo-img {
  width: 200rpx;
  height: 250rpx;
  border-radius: var(--r-m);
  box-shadow: var(--shadow-2);
}

.stage__demo-text {
  margin-top: var(--s1);
  font-size: var(--f-xs);
  color: var(--ink-1);
  max-width: 220rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.stage__demo-sub {
  font-size: var(--f-xs);
  color: var(--ink-3);
}

.stage__hint {
  display: flex;
  flex-direction: row;
  align-items: center;
  align-self: center;
}

.stage__hint-text {
  color: var(--accent-deep);
  font-size: var(--f-m);
  font-weight: 600;
  letter-spacing: 2rpx;
}

.stage__hint-arrow {
  margin-left: var(--s1);
  color: var(--accent-deep);
  font-size: var(--f-m);
}
