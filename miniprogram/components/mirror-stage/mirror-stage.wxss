.stage {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: var(--r-l);
  overflow: hidden;
  background: var(--surface-warm);
  transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease);
}

.stage-press {
  transform: scale(0.985);
  opacity: 0.94;
}

/* ---- recent：结果图 + 说明牌 ---- */
.stage__bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.stage__veil {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 62%;
  background: linear-gradient(180deg, rgba(28, 23, 18, 0) 0%, rgba(28, 23, 18, 0.62) 100%);
}

.stage__plate {
  position: absolute;
  left: var(--s4);
  right: var(--s4);
  bottom: var(--s4);
  display: flex;
  flex-direction: column;
}

.stage__eyebrow {
  font-size: 20rpx;
  letter-spacing: 6rpx;
  color: rgba(255, 255, 255, 0.72);
}

.stage__gname {
  margin-top: 6rpx;
  font-family: var(--serif);
  color: #FFFFFF;
  font-size: 46rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.stage__time {
  margin-top: 2rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: var(--f-xs);
  letter-spacing: 1rpx;
}

.stage__actions {
  margin-top: var(--s3);
  display: flex;
  flex-direction: row;
  align-items: center;
}

.stage__pill {
  min-height: 84rpx;
  padding: 0 var(--s4);
  border-radius: var(--r-full);
  background: rgba(253, 251, 247, 0.94);
  color: var(--ink-1);
  font-size: var(--f-s);
  font-weight: 600;
  letter-spacing: 1rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.stage__pill .i-arrow {
  font-size: 30rpx;
  margin-left: var(--s1);
}

.stage__ghost {
  margin-left: var(--s3);
  min-height: 84rpx;
  display: flex;
  align-items: center;
  color: rgba(255, 255, 255, 0.85);
  font-size: var(--f-xs);
  letter-spacing: 2rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.45);
}

/* ---- empty：镜面 ---- */
.stage__mirror {
  position: absolute;
  left: var(--s3);
  right: var(--s3);
  top: var(--s3);
  bottom: var(--s3);
  border: 1rpx solid var(--line-strong);
  border-radius: 240rpx 240rpx var(--r-l) var(--r-l);
  background: linear-gradient(168deg, #F9F5EC 0%, #F1EADC 55%, #EAE1CE 100%);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: calc(var(--s10) + var(--s3)) var(--s5) var(--s5);
  overflow: hidden;
}

/* 内侧第二道发丝线，镜面装裱感 */
.stage__mirror::before {
  content: "";
  position: absolute;
  left: 14rpx;
  right: 14rpx;
  top: 14rpx;
  bottom: 14rpx;
  border: 1rpx solid rgba(207, 194, 173, 0.6);
  border-radius: 226rpx 226rpx 24rpx 24rpx;
  pointer-events: none;
}

/* 缓慢掠过的柔光 */
.stage__sheen {
  position: absolute;
  top: -20%;
  bottom: -20%;
  left: -30%;
  width: 45%;
  background: linear-gradient(105deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.5) 50%, rgba(255, 255, 255, 0) 100%);
  transform: skewX(-12deg);
  animation: sheen 7s var(--ease) infinite;
  pointer-events: none;
}

@keyframes sheen {
  0%, 55% { left: -45%; }
  85%, 100% { left: 130%; }
}

.stage__steps {
  display: flex;
  flex-direction: column;
  align-self: flex-start;
}

.stage__step {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  min-height: 72rpx;
}

.stage__step + .stage__step {
  border-top: 1rpx solid rgba(207, 194, 173, 0.55);
}

.stage__no {
  width: 72rpx;
  font-family: var(--serif);
  font-size: var(--f-m);
  color: var(--accent);
  letter-spacing: 2rpx;
}

.stage__step-text {
  color: var(--ink-1);
  font-size: var(--f-m);
  letter-spacing: 2rpx;
}

.stage__demo {
  position: absolute;
  right: var(--s5);
  top: 30%;
  width: 216rpx;
  display: flex;
  flex-direction: column;
}

.stage__demo-frame {
  padding: 10rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow-2);
}

.stage__demo-img {
  width: 100%;
  height: 244rpx;
  display: block;
}

.stage__demo-eyebrow {
  margin-top: var(--s2);
  font-size: 18rpx;
  letter-spacing: 5rpx;
  color: var(--ink-3);
}

.stage__demo-text {
  margin-top: 2rpx;
  font-family: var(--serif);
  font-size: var(--f-s);
  color: var(--ink-1);
  max-width: 240rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.stage__hint {
  display: flex;
  flex-direction: row;
  align-items: center;
  align-self: center;
  padding-bottom: var(--s1);
}

.stage__hint-text {
  color: var(--accent-deep);
  font-size: var(--f-s);
  font-weight: 600;
  letter-spacing: 5rpx;
}

.stage__hint-arrow {
  font-size: 30rpx;
  color: var(--accent-deep);
  margin-left: var(--s2);
}
