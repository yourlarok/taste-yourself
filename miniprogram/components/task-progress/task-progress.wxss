.task-progress {
  width: 560rpx;
  padding: 42rpx 40rpx 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: var(--r-l);
  background: rgba(33, 27, 20, 0.86);
  color: #FFFFFF;
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.22);
}

.task-progress__eyebrow {
  display: block;
  color: rgba(255, 255, 255, 0.58);
  font-size: 20rpx;
  letter-spacing: 5rpx;
}

.task-progress__detail {
  display: block;
  margin-top: 12rpx;
  font-family: var(--serif);
  font-size: 34rpx;
  line-height: 1.45;
}

.task-progress__steps {
  margin-top: 34rpx;
}

.task-progress__step {
  position: relative;
  min-height: 72rpx;
  display: flex;
  align-items: flex-start;
  color: rgba(255, 255, 255, 0.34);
}

.task-progress__step:not(:last-child)::after {
  content: "";
  position: absolute;
  left: 16rpx;
  top: 36rpx;
  width: 1rpx;
  height: 36rpx;
  background: rgba(255, 255, 255, 0.16);
}

.task-progress__mark {
  width: 34rpx;
  height: 34rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16rpx;
  flex: none;
}

.task-progress__check { font-size: 20rpx; line-height: 1; }

.task-progress__label {
  margin: 2rpx 0 0 20rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.task-progress__step--current { color: #FFFFFF; }
.task-progress__step--current .task-progress__mark {
  color: #211B14;
  background: var(--accent-soft);
  border-color: var(--accent-soft);
}
.task-progress__step--done { color: rgba(255, 255, 255, 0.68); }
.task-progress__step--done .task-progress__mark {
  color: var(--accent-soft);
  border-color: rgba(224, 200, 160, 0.45);
}

.task-progress__note {
  display: block;
  margin-top: 10rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.42);
  font-size: 20rpx;
  letter-spacing: 2rpx;
}
