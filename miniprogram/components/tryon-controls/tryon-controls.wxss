.tc {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 var(--s4);
}

/* ---- 主操作：快门语义，深墨底 ---- */
.tc__main {
  width: 100%;
  min-height: 116rpx;
  border-radius: var(--r-full);
  background: rgba(33, 27, 20, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-2);
  transition: opacity var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
}

.tc__main.is-disabled {
  background: rgba(120, 110, 96, 0.55);
  border-color: transparent;
  box-shadow: none;
}

.tc__shutter {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--s2);
}

.tc__shutter-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--accent-soft);
}

.tc__main-col {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.tc__main-text {
  color: #FFFFFF;
  font-size: var(--f-m);
  font-weight: 600;
  letter-spacing: 3rpx;
  line-height: 1.3;
}

.tc__main-sub {
  margin-top: 2rpx;
  color: rgba(255, 255, 255, 0.55);
  font-size: 20rpx;
  letter-spacing: 2rpx;
  max-width: 460rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tc__main.is-disabled .tc__main-text,
.tc__main.is-disabled .tc__main-sub {
  color: rgba(255, 255, 255, 0.75);
}

.tc__main .spinner {
  margin-right: var(--s2);
}

.tc__hint {
  margin-top: var(--s2);
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* ---- 二级入口：磨砂发丝胶囊 ---- */
.tc__sub {
  margin-top: var(--s3);
  display: flex;
  flex-direction: row;
  align-items: center;
}

.tc__subbtn {
  min-height: 88rpx;
  padding: 0 var(--s4);
  display: flex;
  align-items: center;
  border-radius: var(--r-full);
  background: var(--frost);
  border: 1rpx solid var(--frost-light);
  font-size: var(--f-xs);
  letter-spacing: 3rpx;
  color: rgba(255, 255, 255, 0.92);
}

.tc__subbtn + .tc__subbtn {
  margin-left: var(--s2);
}

/* ---- 动态试衣进行中 ---- */
.tc__rt {
  width: 100%;
  min-height: 104rpx;
  border-radius: var(--r-full);
  background: rgba(33, 27, 20, 0.78);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--s2) 0 var(--s4);
}

.tc__rt-info {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.tc__rt-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #E9D9C4;
  margin-right: var(--s2);
  animation: rt-blink 1.2s var(--ease) infinite;
}

@keyframes rt-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.25; }
}

.tc__rt-text {
  color: rgba(255, 255, 255, 0.9);
  font-size: var(--f-xs);
  letter-spacing: 2rpx;
}

.tc__rt .spinner {
  margin-right: var(--s2);
}

.tc__rt-end {
  min-height: 72rpx;
  padding: 0 var(--s4);
  border-radius: var(--r-full);
  background: rgba(253, 251, 247, 0.94);
  color: var(--ink-1);
  font-size: var(--f-xs);
  font-weight: 600;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
}

.tc__rt-end.is-disabled {
  opacity: 0.4;
}
