.gs {
  width: 100%;
}

.gs__row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 0 var(--s3);
}

.gs__section {
  flex: none;
  align-self: center;
  width: 40rpx;
  margin-right: var(--s2);
  font-size: 20rpx;
  letter-spacing: 6rpx;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.5;
  writing-mode: vertical-lr;
}

.gs__item {
  flex: none;
  width: 148rpx;
  margin-right: var(--s2);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.gs__thumb {
  position: relative;
  width: 148rpx;
  height: 186rpx;
  border-radius: var(--r-m);
  overflow: hidden;
  background: var(--surface);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  transition: border-color var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
}

.gs__thumb image {
  width: 100%;
  height: 100%;
}

.gs__item.is-selected .gs__thumb {
  border: 2rpx solid #E9D9C4;
  box-shadow: 0 0 0 3rpx rgba(154, 106, 69, 0.65);
}

.gs__check {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
}

.gs__check .i-check {
  font-size: 24rpx;
  color: #FFFFFF;
}

.gs__name {
  margin-top: 8rpx;
  width: 148rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: rgba(255, 255, 255, 0.78);
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.gs__item.is-selected .gs__name {
  color: #FFFFFF;
}

.gs__empty {
  flex: none;
  align-self: center;
  margin-right: var(--s2);
  padding: 0 var(--s2);
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
}

.gs__thumb--status {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--surface-warm);
  border: none;
}

.gs__thumb--status .spinner {
  border-color: var(--line-strong);
  border-top-color: var(--accent);
}

.gs__thumb--error {
  background: var(--accent-soft);
}

.gs__status-title {
  font-size: 20rpx;
  color: var(--accent-deep);
  font-weight: 600;
}

.gs__status-text {
  margin-top: 6rpx;
  font-size: 18rpx;
  color: var(--ink-2);
}

.gs__thumb--add {
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  background: rgba(255, 255, 255, 0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.gs__add-icon {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.85);
}

.gs__add-text {
  margin-top: 8rpx;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, 0.75);
}

.gs__broken {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  color: var(--ink-3);
  background: var(--surface-warm);
}
