.gs {
  width: 100%;
}

.gs__row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 0 var(--s3);
}

.gs__section {
  flex: none;
  align-self: center;
  width: 44rpx;
  margin-right: var(--s2);
  font-size: var(--f-xs);
  color: var(--ink-3);
  line-height: 1.4;
  writing-mode: vertical-lr;
  letter-spacing: 4rpx;
}

.gs__item {
  flex: none;
  width: 144rpx;
  margin-right: var(--s2);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.gs__item--static {
  cursor: default;
}

.gs__thumb {
  position: relative;
  width: 144rpx;
  height: 180rpx;
  border-radius: var(--r-s);
  overflow: hidden;
  background: var(--surface);
  border: 2rpx solid transparent;
  transition: border-color var(--dur-fast) var(--ease);
}

.gs__thumb image {
  width: 100%;
  height: 100%;
}

.gs__item.is-selected .gs__thumb {
  border-color: var(--accent);
}

.gs__check {
  position: absolute;
  right: 6rpx;
  top: 6rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--accent);
  color: #FFFFFF;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gs__name {
  margin-top: 6rpx;
  width: 144rpx;
  font-size: var(--f-xs);
  color: var(--ink-2);
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.gs__item.is-selected .gs__name {
  color: var(--accent-deep);
}

.gs__empty {
  flex: none;
  align-self: center;
  margin-right: var(--s2);
  padding: 0 var(--s2);
  font-size: var(--f-xs);
  color: var(--ink-3);
}

.gs__thumb--status {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--surface-warm);
}

.gs__thumb--error {
  background: var(--accent-soft);
}

.gs__status-title {
  font-size: var(--f-xs);
  color: var(--accent-deep);
  font-weight: 600;
}

.gs__status-text {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--ink-2);
}

.gs__thumb--add {
  border: 2rpx dashed var(--line-strong);
  background: transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.gs__add-icon {
  font-size: 44rpx;
  color: var(--ink-2);
  line-height: 1;
}

.gs__add-text {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--ink-2);
}

.gs__broken {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: var(--ink-3);
  background: var(--surface-warm);
}
