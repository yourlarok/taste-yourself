.sg {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: #211D18;
  z-index: 80;
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--dur) var(--ease);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sg.is-open {
  opacity: 1;
  pointer-events: auto;
}

.sg__top {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
}

.sg__step-text {
  color: rgba(255, 255, 255, 0.75);
  font-size: var(--f-s);
}

.sg__cancel {
  min-width: 88rpx;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.85);
  font-size: var(--f-s);
}

/* ---- 知情同意 ---- */
.sg__consent {
  flex: 1;
  width: 100%;
  padding: var(--s6) var(--s6) 0;
  display: flex;
  flex-direction: column;
}

.sg__consent-title {
  color: #FFFFFF;
  font-size: var(--f-xl);
  font-weight: 600;
}

.sg__consent-desc {
  margin-top: var(--s3);
  color: rgba(255, 255, 255, 0.78);
  font-size: var(--f-m);
  line-height: 1.6;
}

.sg__consent-points {
  margin-top: var(--s5);
  display: flex;
  flex-direction: column;
}

.sg__consent-point {
  color: rgba(255, 255, 255, 0.62);
  font-size: var(--f-s);
  line-height: 1.9;
}

.sg__btn-primary {
  margin-top: var(--s8);
  min-height: 104rpx;
  border-radius: var(--r-full);
  background: #FFFFFF;
  color: var(--ink-1);
  font-size: var(--f-m);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sg__btn-plain {
  margin-top: var(--s2);
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.7);
  font-size: var(--f-m);
}

/* ---- 采集画面 ---- */
.sg__stage {
  position: relative;
  width: 100%;
  flex: 1;
  overflow: hidden;
}

.sg__camera {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.sg__camera-placeholder {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, #2C2721 0%, #211D18 100%);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: var(--s8);
}

.sg__camera-tip {
  color: rgba(255, 255, 255, 0.5);
  font-size: var(--f-xs);
  padding: 0 var(--s6);
  text-align: center;
}

.sg__outline {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -52%);
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0.85;
}

.sg__outline-head {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 3rpx dashed rgba(255, 255, 255, 0.75);
}

.sg__outline-body {
  margin-top: 12rpx;
  width: 320rpx;
  height: 560rpx;
  border: 3rpx dashed rgba(255, 255, 255, 0.75);
  border-radius: 160rpx 160rpx 48rpx 48rpx;
}

.sg__outline-body--side {
  width: 200rpx;
}

.sg__count {
  position: absolute;
  left: 50%;
  top: 38%;
  transform: translate(-50%, -50%);
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  background: rgba(32, 27, 22, 0.55);
  border: 2rpx solid rgba(255, 255, 255, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
}

.sg__count-num {
  color: #FFFFFF;
  font-size: 88rpx;
  font-weight: 600;
}

.sg__flash {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.85);
  animation: sg-flash 320ms var(--ease) forwards;
}

@keyframes sg-flash {
  from { opacity: 1; }
  to { opacity: 0; }
}

.sg__guide {
  margin-top: var(--s4);
  color: #FFFFFF;
  font-size: var(--f-m);
  font-weight: 600;
  padding: 0 var(--s6);
  text-align: center;
}

.sg__guide-sub {
  margin-top: 6rpx;
  margin-bottom: var(--s6);
  color: rgba(255, 255, 255, 0.55);
  font-size: var(--f-xs);
}

/* ---- 处理中 ---- */
.sg__processing {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.sg__processing .spinner {
  width: 56rpx;
  height: 56rpx;
  border-color: rgba(255, 255, 255, 0.25);
  border-top-color: #FFFFFF;
}

.sg__steps {
  margin-top: var(--s6);
  display: flex;
  flex-direction: column;
}

.sg__step {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 72rpx;
  opacity: 0.4;
}

.sg__step.is-current {
  opacity: 1;
}

.sg__step.is-done {
  opacity: 0.75;
}

.sg__step-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  color: rgba(255, 255, 255, 0.85);
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--s2);
}

.sg__step.is-current .sg__step-dot {
  background: #FFFFFF;
  color: var(--ink-1);
  border-color: #FFFFFF;
}

.sg__step-label {
  color: rgba(255, 255, 255, 0.9);
  font-size: var(--f-s);
}

/* ---- 结果态（补拍 / 完成 / 失败） ---- */
.sg__result {
  flex: 1;
  width: 100%;
  padding: 0 var(--s6);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.sg__result-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  color: #FFFFFF;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sg__result-icon--ok {
  background: #FFFFFF;
  color: var(--ink-1);
  border-color: #FFFFFF;
}

.sg__result-title {
  margin-top: var(--s4);
  color: #FFFFFF;
  font-size: var(--f-l);
  font-weight: 600;
}

.sg__result-desc {
  margin-top: var(--s2);
  color: rgba(255, 255, 255, 0.65);
  font-size: var(--f-s);
  text-align: center;
  line-height: 1.6;
}

.sg__result .sg__btn-primary {
  margin-top: var(--s6);
  width: 100%;
}

.sg__result .sg__btn-plain {
  width: 100%;
}
