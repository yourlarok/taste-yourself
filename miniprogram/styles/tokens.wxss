/* tokens.wxss — 设计 token v2：纸感编辑风
 * 气质：安静、克制、可信、偏编辑设计。
 * 暖纸底色 + 深墨文字 + 单一低饱和陶土强调色（只作点缀：选中、序号、进度）。
 * 颜色不用于表达“尺码正确/错误”；danger 仅用于删除类危险操作。
 */
page {
  /* 色彩 */
  --bg: #F7F3EC;              /* 暖纸 */
  --surface: #FDFBF7;         /* 纸面 */
  --surface-warm: #EFE8DB;    /* 深一点的纸 */
  --ink-1: #211B14;           /* 主文字：深墨 */
  --ink-2: #796E5F;
  --ink-3: #ACA08D;
  --line: #E4DACA;            /* 发丝线 */
  --line-strong: #CFC2AD;
  --accent: #9A6A45;          /* 陶土 */
  --accent-deep: #7C5132;
  --accent-soft: #EEE1CF;
  --mask: rgba(28, 23, 18, 0.48);
  --danger: #A8543F;
  --frost: rgba(38, 32, 25, 0.42);          /* 镜前磨砂控件底 */
  --frost-light: rgba(255, 255, 255, 0.14); /* 磨砂上的发丝边 */

  /* 字体 */
  --serif: Georgia, "Times New Roman", "Songti SC", "STSong", serif;

  /* 间距：8rpx 基线 */
  --s1: 8rpx;
  --s2: 16rpx;
  --s3: 24rpx;
  --s4: 32rpx;
  --s5: 40rpx;
  --s6: 48rpx;
  --s8: 64rpx;
  --s10: 80rpx;

  /* 圆角 */
  --r-s: 12rpx;
  --r-m: 20rpx;
  --r-l: 32rpx;
  --r-full: 999rpx;

  /* 字号 */
  --f-xs: 22rpx;
  --f-s: 26rpx;
  --f-m: 30rpx;
  --f-l: 36rpx;
  --f-xl: 44rpx;
  --f-xxl: 56rpx;

  /* 阴影：低、软、暖 */
  --shadow-1: 0 4rpx 20rpx rgba(33, 27, 20, 0.06);
  --shadow-2: 0 18rpx 48rpx rgba(33, 27, 20, 0.12);

  /* 动效：单次 180–280ms，仅用于连续性与状态反馈 */
  --dur-fast: 180ms;
  --dur: 240ms;
  --dur-slow: 280ms;
  --ease: cubic-bezier(0.22, 0.8, 0.32, 1);
}

/* 通用按压反馈 */
.tap-dim {
  opacity: 0.5;
  transition: opacity var(--dur-fast) var(--ease);
}

.btn-press {
  opacity: 0.86;
  transform: scale(0.982);
  transition: opacity var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
}

/* 编辑式小标签：宽字距中文 / 小字号 */
.eyebrow {
  font-size: 20rpx;
  letter-spacing: 6rpx;
  color: var(--ink-3);
}
