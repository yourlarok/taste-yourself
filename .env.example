APP_ENV=development
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
DATABASE_PATH=data/taste-yourself.db
MEDIA_ROOT=data/media
STATIC_DAILY_LIMIT=20
REALTIME_DAILY_LIMIT=3
PERSON_IMAGE_RETENTION_DAYS=7
TRYON_RESULT_RETENTION_DAYS=30
TRYON_PROVIDER=fashn-api
FASHN_API_BASE_URL=https://api.fashn.ai/v1
FASHN_API_KEY=
FASHN_WORKER_URL=http://127.0.0.1:9000
FASHN_WORKER_TOKEN=
# WebRTC live VTON via Decart Realtime API. No post-recording fallback.
REALTIME_PROVIDER=decart-realtime
# Server-only credential; never copy into miniprogram/env.js.
DECART_API_KEY=
REALTIME_WEB_ORIGIN=https://tryon.xuefeitryon.com

# Required before a real-device beta. Never put these values in miniprogram code.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
PUBLIC_DOMAIN=api.example.com
PUBLIC_API_BASE_URL=https://api.example.com/api/v1

# Mirror Agent. Use a server-side OpenAI-compatible endpoint such as Bailian.
MIRROR_LLM_BASE_URL=
MIRROR_LLM_API_KEY=
MIRROR_LLM_MODEL=
MIRROR_VISION_MODEL=
MIRROR_ASR_MODEL=qwen3-asr-flash

# Taobao Open Platform. Official API only; the service never scrapes product pages.
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_SESSION=
TAOBAO_ITEM_API_METHOD=taobao.tbk.item.info.get

# Configure the selected static/realtime/body-measurement providers later.
BODY_SCAN_PROVIDER=disabled
BODYGRAM_ORG_ID=
BODYGRAM_API_KEY=
CONTENT_SAFETY_PROVIDER=wechat
CONTENT_SAFETY_URL=
CONTENT_SAFETY_TOKEN=
FASHN_WEIGHTS_HOST_PATH=./data/fashn-weights
